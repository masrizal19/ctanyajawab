<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512" fill="none">
  <!-- Radiating Shock Sparks -->
  <line x1="256" y1="20" x2="256" y2="60" stroke="#1e293b" stroke-width="14" stroke-linecap="round" />
  <line x1="130" y1="75" x2="155" y2="105" stroke="#1e293b" stroke-width="14" stroke-linecap="round" />
  <line x1="382" y1="75" x2="357" y2="105" stroke="#1e293b" stroke-width="14" stroke-linecap="round" />
  <line x1="60" y1="180" x2="95" y2="195" stroke="#1e293b" stroke-width="14" stroke-linecap="round" />
  <line x1="452" y1="180" x2="417" y2="195" stroke="#1e293b" stroke-width="14" stroke-linecap="round" />
  <line x1="75" y1="360" x2="105" y2="340" stroke="#1e293b" stroke-width="14" stroke-linecap="round" />
  <line x1="437" y1="360" x2="407" y2="340" stroke="#1e293b" stroke-width="14" stroke-linecap="round" />
  <line x1="256" y1="460" x2="256" y2="495" stroke="#1e293b" stroke-width="14" stroke-linecap="round" />
  <line x1="160" y1="440" x2="175" y2="470" stroke="#1e293b" stroke-width="14" stroke-linecap="round" />
  <line x1="352" y1="440" x2="337" y2="470" stroke="#1e293b" stroke-width="14" stroke-linecap="round" />

  <!-- Central/Top Question Mark -->
  <g>
    <!-- Hook -->
    <path d="M210 170 C210 105, 305 105, 305 165 C305 210, 256 215, 256 270" 
          stroke="#1e293b" stroke-width="26" stroke-linecap="round" fill="none" />
    <path d="M210 170 C210 105, 305 105, 305 165 C305 210, 256 215, 256 270" 
          stroke="#f6bf43" stroke-width="16" stroke-linecap="round" fill="none" />
    <!-- Dot -->
    <circle cx="256" cy="325" r="14" fill="#f6bf43" stroke="#1e293b" stroke-width="7" />
  </g>

  <!-- Left Question Mark -->
  <g transform="rotate(-20 160 300)">
    <!-- Hook -->
    <path d="M120 210 C120 150, 205 150, 205 205 C205 245, 160 250, 160 300" 
          stroke="#1e293b" stroke-width="24" stroke-linecap="round" fill="none" />
    <path d="M120 210 C120 150, 205 150, 205 205 C205 245, 160 250, 160 300" 
          stroke="#fbd578" stroke-width="14" stroke-linecap="round" fill="none" />
    <!-- Dot -->
    <circle cx="160" cy="350" r="13" fill="#fbd578" stroke="#1e293b" stroke-width="6" />
  </g>

  <!-- Right Question Mark -->
  <g transform="rotate(20 350 300)">
    <!-- Hook -->
    <path d="M310 210 C310 150, 395 150, 395 205 C395 245, 350 250, 350 300" 
          stroke="#1e293b" stroke-width="24" stroke-linecap="round" fill="none" />
    <path d="M310 210 C310 150, 395 150, 395 205 C395 245, 350 250, 350 300" 
          stroke="#fbd578" stroke-width="14" stroke-linecap="round" fill="none" />
    <!-- Dot -->
    <circle cx="350" cy="350" r="13" fill="#fbd578" stroke="#1e293b" stroke-width="6" />
  </g>
</svg>
